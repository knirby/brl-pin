# Status, enable, disable

def status():
    try:
        state = json.loads(STATE.read_text())
    except (OSError, ValueError):
        die("No state yet. Run `sudo brl-desktop sync` or `sudo brl-desktop enable`.")
    print(f"init stratum: {state['native']} (its launchers are used directly)")
    print(f"other strata: {', '.join(state['foreign']) or '(none)'}")
    print(f"launchers in {APPS}: {len(state['entries'])}, icons: {state['icons']}, "
          f"updated {state['updated']}")
    by_stratum = {}
    for entry_id, source in sorted(state["entries"].items()):
        by_stratum.setdefault(source.split(":", 1)[0], []).append(entry_id)
    for stratum, ids in by_stratum.items():
        print(f"  {stratum}: {', '.join(ids)}")
    if state["hidden"]:
        print(f"hidden in favour of a pinned stratum: {', '.join(state['hidden'])}")
    environment = os.environ.get("XDG_DATA_DIRS", "")
    if str(SHARE) not in environment.split(":"):
        print(f"note: {SHARE} is not in this session's XDG_DATA_DIRS yet; log out and back in.")


def configure(content, enable):
    out = []
    for line in content.splitlines():
        if enable and APPS_LINE.match(line):
            out.append(f"{CONF_MARK} {line.strip()}")
            continue
        if not enable and line.startswith(f"{CONF_MARK} applications"):
            out.append(line[len(CONF_MARK) + 1:])
            continue
        match = XDG_PREFIX.match(line)
        if match:
            items = [item for item in match.group(2).split(":") if item and item != str(SHARE)]
            if enable:
                items.insert(0, str(SHARE))
            line = match.group(1) + ":".join(items)
        out.append(line)
    return "\n".join(out) + "\n"


def brl_apply():
    try:
        subprocess.run(["brl", "apply"], check=True)
    except (OSError, subprocess.CalledProcessError):
        die("`brl apply` failed. Check the output above.")


def systemctl(*arguments):
    subprocess.run(["systemctl", *arguments], check=False)


def enable():
    require_root()
    content = read_conf()
    updated = configure(content, enable=True)
    if updated != content:
        shutil.copy2(CONF, CONF.with_name("bedrock.conf.brl-desktop-backup"))
        CONF.write_text(updated)
        log(f"updated {CONF} (backup: bedrock.conf.brl-desktop-backup)")
        brl_apply()
    for path, unit in UNITS.items():
        write_if_changed(Path(path), unit)
    systemctl("daemon-reload")
    systemctl("enable", "--now", "brl-desktop.service")
    systemctl("--global", "enable", "brl-desktop-prune.service")
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user:
        subprocess.run(["systemctl", f"--machine={sudo_user}@.host", "--user", "start",
                        "brl-desktop-prune.service"], check=False)
    log("enabled. Log out and back in once so your session picks up the new XDG_DATA_DIRS.")


def disable():
    require_root()
    systemctl("--global", "disable", "brl-desktop-prune.service")
    systemctl("disable", "--now", "brl-desktop.service")
    for path in UNITS:
        Path(path).unlink(missing_ok=True)
    systemctl("daemon-reload")
    content = read_conf()
    updated = configure(content, enable=False)
    if updated != content:
        CONF.write_text(updated)
        brl_apply()
    shutil.rmtree(SHARE, ignore_errors=True)
    STATE.unlink(missing_ok=True)
    log("disabled. crossfs launchers are back after your next login.")


def main():
    args = sys.argv[1:]
    commands = {
        ("sync",): lambda: (require_root(), sync()),
        ("watch",): watch_system,
        ("watch", "--user"): watch_user,
        ("prune",): prune,
        ("status",): status,
        ("enable",): enable,
        ("disable",): disable,
    }
    command = commands.get(tuple(args))
    if command is None:
        print(__doc__.strip())
        sys.exit(1)
    try:
        command()
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
