#!/usr/bin/env python3
"""
brl-pin - Simple tool to pin commands to specific strata in Bedrock Linux

Usage:
    brl-pin <command>                       # pin the provider selected by Bedrock
    brl-pin --list                          # show current pins
    brl-pin --rm <command>                  # remove a pin
    brl-pin --install                       # install brl-pin
    brl-pin --update                        # update from GitHub
    brl-pin --uninstall                     # remove the installation
"""

import sys
import os
import pwd
import re
import shutil
import subprocess
import tempfile
from pathlib import Path

CONF = Path("/bedrock/etc/bedrock.conf")
REPOSITORY = "https://github.com/knirby/brl-pin.git"

def die(msg: str, code: int = 1):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)

def require_root():
    if os.geteuid() != 0:
        die("This operation requires root. Re-run with sudo.")

def read_conf() -> str:
    try:
        return CONF.read_text()
    except Exception as e:
        die(f"Failed to read {CONF}: {e}")

def write_conf(content: str):
    try:
        CONF.write_text(content)
    except Exception as e:
        die(f"Failed to write {CONF}: {e}")

def apply_config():
    try:
        subprocess.run(["brl", "apply"], check=True)
    except subprocess.CalledProcessError:
        die("`brl apply` failed. Check the output above.")
    except FileNotFoundError:
        die("`brl` command not found. Is Bedrock installed correctly?")

def run_lookup(args):
    try:
        result = subprocess.run(args, check=True, capture_output=True, text=True)
    except FileNotFoundError:
        die(f"`{args[0]}` command not found.")
    except subprocess.CalledProcessError as e:
        detail = (e.stderr or e.stdout).strip()
        die(detail or f"`{' '.join(args)}` failed.")

    output = result.stdout.strip()
    if not output or "\n" in output:
        die(f"`{' '.join(args)}` returned an unexpected result: {output!r}")
    return output

def resolve_command(cmd: str):
    provider = run_lookup(["brl", "which", "--bin", cmd])

    if provider == "global":
        path = run_lookup(["which", cmd])
    else:
        path = run_lookup(["brl", "strat", "--restrict", provider, "which", cmd])

    if not Path(path).is_absolute():
        die(f"Resolved command path is not absolute: {path}")

    actual_provider = run_lookup(["brl", "which", "--file", path])
    if actual_provider != provider:
        die(f"Resolved {cmd} to {path} in {actual_provider}, expected {provider}.")

    return provider, path

def installation_path():
    home = Path.home().resolve()
    if os.geteuid() == 0:
        system_bin = Path("/usr/local/bin")
        if system_bin.is_dir() and os.access(system_bin, os.W_OK):
            return system_bin / "brl-pin"
        die("Cannot install: /usr/local/bin must exist and be writable.")

    user_bins = {(home / ".local" / "bin").resolve(), (home / "bin").resolve()}

    for entry in os.environ.get("PATH", "").split(os.pathsep):
        directory = Path(entry or ".").expanduser().resolve()
        if directory not in user_bins:
            continue
        if directory.is_dir() and os.access(directory, os.W_OK):
            return directory / "brl-pin"

    die("No writable ~/bin or ~/.local/bin directory is on PATH. Re-run with sudo to install in /usr/local/bin.")

def current_installation_path():
    running_file = Path(__file__).resolve()
    homes = {Path.home().resolve()}
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user:
        try:
            homes.add(Path(pwd.getpwnam(sudo_user).pw_dir).resolve())
        except KeyError:
            pass
    user_bins = {
        directory.resolve()
        for home in homes
        for directory in (home / ".local" / "bin", home / "bin")
    }
    if running_file.name == "brl-pin":
        parent = running_file.parent
        if parent == Path("/usr/local/bin") or parent in user_bins:
            return running_file
        if parent.name == "bin" and parent.parent.name == ".local":
            return running_file
    return installation_path()

def install_file(source: Path, destination: Path):
    try:
        descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix=".brl-pin-")
        os.close(descriptor)
        try:
            shutil.copyfile(source, temporary)
            os.chmod(temporary, 0o755)
            os.replace(temporary, destination)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    except PermissionError:
        die(f"Permission denied writing {destination}. Re-run with sudo to install or update it.")

def install_tool():
    destination = installation_path()
    install_file(Path(__file__).resolve(), destination)
    print(f"Installed brl-pin to {destination}")

def update_tool():
    destination = current_installation_path()
    try:
        with tempfile.TemporaryDirectory(prefix="brl-pin-update-") as temporary:
            checkout = Path(temporary) / "repo"
            subprocess.run(["git", "clone", "--depth", "1", REPOSITORY, str(checkout)], check=True)
            source = checkout / "brl-pin"
            if not source.is_file():
                die("Repository does not contain brl-pin.")
            install_file(source, destination)
    except FileNotFoundError:
        die("`git` is required to update brl-pin.")
    except subprocess.CalledProcessError:
        die("Update failed. Check the git output above.")
    print("Updated brl-pin from GitHub.")

def uninstall_tool():
    destination = current_installation_path()
    try:
        destination.unlink()
    except FileNotFoundError:
        pass
    except PermissionError:
        die(f"Permission denied removing {destination}. Re-run with sudo to uninstall it.")
    print("Removed the local brl-pin installation.")

def usage():
    print(__doc__.strip())
    sys.exit(1)

def list_pins(content: str):
    print("Current pins in [cross-bin]:")
    found = False
    for line in content.splitlines():
        stripped = line.strip()
        if stripped.startswith("pin/bin/"):
            print(f"  {stripped}")
            found = True
    if not found:
        print("  (none)")

def remove_pin(content: str, cmd: str) -> str:
    pattern = re.compile(rf"^\s*pin/bin/{re.escape(cmd)}\s*=")
    new_lines = [line for line in content.splitlines() if not pattern.match(line)]
    return "\n".join(new_lines) + "\n"

def add_pin(content: str, cmd: str, stratum: str, path: str) -> str:
    pin_line = f"pin/bin/{cmd} = {stratum}:{path}"

    # First remove any existing pin for this command
    content = remove_pin(content, cmd)

    lines = content.splitlines()
    final = []
    inserted = False

    for line in lines:
        final.append(line)
        if line.strip() == "[cross-bin]" and not inserted:
            final.append(pin_line)
            inserted = True

    if not inserted:
        # Section didn't exist – create it
        final.append("")
        final.append("[cross-bin]")
        final.append(pin_line)

    return "\n".join(final) + "\n"

def main():
    if len(sys.argv) < 2:
        usage()

    args = sys.argv[1:]

    if args[0] in {"--install", "--update", "--uninstall"}:
        if len(args) != 1:
            usage()
        {
            "--install": install_tool,
            "--update": update_tool,
            "--uninstall": uninstall_tool,
        }[args[0]]()
        return

    # --list does not need root
    if args[0] == "--list":
        content = read_conf()
        list_pins(content)
        return

    # Everything else needs root
    require_root()
    content = read_conf()

    if args[0] == "--rm":
        if len(args) != 2:
            usage()
        cmd = args[1]
        new_content = remove_pin(content, cmd)
        write_conf(new_content)
        print(f"Removed pin for '{cmd}'")
        apply_config()
        return

    if len(args) != 1:
        usage()

    cmd = args[0]
    if not cmd:
        die("command must be non-empty")

    stratum, path = resolve_command(cmd)
    new_content = add_pin(content, cmd, stratum, path)
    write_conf(new_content)
    print(f"Pinned {cmd} → {stratum}:{path}")
    apply_config()
    print("Applied successfully.")

if __name__ == "__main__":
    main()
