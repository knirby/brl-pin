#!/usr/bin/env python3
"""
brl-pin - Simple tool to pin commands to specific strata in Bedrock Linux

Usage:
    brl-pin <command> <stratum>             # pin the command from this stratum
    brl-pin --list                          # show current pins
    brl-pin --rm <command>                  # remove a pin
    brl-pin --desktop <command>             # sync its desktop launcher with its pin
    brl-pin --desktop-rm <command>          # remove its managed desktop launcher
    brl-pin --install                       # install brl-pin
    brl-pin --update                        # update from GitHub
    brl-pin --uninstall                     # remove the installation
"""

import sys
import os
import pwd
import re
import shlex
import shutil
import subprocess
import tempfile
from pathlib import Path

CONF = Path("/bedrock/etc/bedrock.conf")
REPOSITORY = "https://github.com/knirby/brl-tools.git"

def die(msg: str, code: int = 1):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)

def require_root():
    if os.geteuid() != 0:
        die("This operation requires root. Re-run with sudo.")

def read_conf() -> str:
    try:
        return CONF.read_text()
    except Exception as e:
        die(f"Failed to read {CONF}: {e}")

def write_conf(content: str):
    try:
        CONF.write_text(content)
    except Exception as e:
        die(f"Failed to write {CONF}: {e}")

def apply_config():
    try:
        subprocess.run(["brl", "apply"], check=True)
    except KeyboardInterrupt:
        print("\nInterrupted while applying Bedrock configuration.", file=sys.stderr)
        raise SystemExit(130)
    except subprocess.CalledProcessError:
        die("`brl apply` failed. Check the output above.")
    except FileNotFoundError:
        die("`brl` command not found. Is Bedrock installed correctly?")

def run_lookup(args):
    try:
        result = subprocess.run(args, check=True, capture_output=True, text=True)
    except FileNotFoundError:
        die(f"`{args[0]}` command not found.")
    except subprocess.CalledProcessError as e:
        detail = (e.stderr or e.stdout).strip()
        die(detail or f"`{' '.join(args)}` failed.")

    output = result.stdout.strip()
    if not output or "\n" in output:
        die(f"`{' '.join(args)}` returned an unexpected result: {output!r}")
    return output

def resolve_command(cmd: str, stratum: str):
    path = run_lookup(["brl", "strat", "--restrict", stratum, "which", cmd])
    if not Path(path).is_absolute():
        die(f"Resolved command path is not absolute: {path}")

    return path

def installation_path():
    home = Path.home().resolve()
    if os.geteuid() == 0:
        system_bin = Path("/usr/local/bin")
        if system_bin.is_dir() and os.access(system_bin, os.W_OK):
            return system_bin / "brl-pin"
        die("Cannot install: /usr/local/bin must exist and be writable.")

    user_bins = {(home / ".local" / "bin").resolve(), (home / "bin").resolve()}

    for entry in os.environ.get("PATH", "").split(os.pathsep):
        directory = Path(entry or ".").expanduser().resolve()
        if directory not in user_bins:
            continue
        if directory.is_dir() and os.access(directory, os.W_OK):
            return directory / "brl-pin"

    die("No writable ~/bin or ~/.local/bin directory is on PATH. Re-run with sudo to install in /usr/local/bin.")

def current_installation_path():
    running_file = Path(__file__).resolve()
    homes = {Path.home().resolve()}
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user:
        try:
            homes.add(Path(pwd.getpwnam(sudo_user).pw_dir).resolve())
        except KeyError:
            pass
    user_bins = {
        directory.resolve()
        for home in homes
        for directory in (home / ".local" / "bin", home / "bin")
    }
    if running_file.name == "brl-pin":
        parent = running_file.parent
        if parent == Path("/usr/local/bin") or parent in user_bins:
            return running_file
        if parent.name == "bin" and parent.parent.name == ".local":
            return running_file
    return installation_path()

def install_file(source: Path, destination: Path):
    try:
        descriptor, temporary = tempfile.mkstemp(dir=destination.parent, prefix=".brl-pin-")
        os.close(descriptor)
        try:
            shutil.copyfile(source, temporary)
            os.chmod(temporary, 0o755)
            os.replace(temporary, destination)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    except PermissionError:
        die(f"Permission denied writing {destination}. Re-run with sudo to install or update it.")

def install_tool():
    destination = installation_path()
    install_file(Path(__file__).resolve(), destination)
    print(f"Installed brl-pin to {destination}")

def update_tool():
    destination = current_installation_path()
    try:
        with tempfile.TemporaryDirectory(prefix="brl-pin-update-") as temporary:
            checkout = Path(temporary) / "repo"
            subprocess.run(["git", "clone", "--depth", "1", REPOSITORY, str(checkout)], check=True)
            source = checkout / "brl-pin"
            if not source.is_file():
                die("Repository does not contain brl-pin.")
            install_file(source, destination)
    except FileNotFoundError:
        die("`git` is required to update brl-pin.")
    except subprocess.CalledProcessError:
        die("Update failed. Check the git output above.")
    print("Updated brl-pin from GitHub.")

def uninstall_tool():
    destination = current_installation_path()
    try:
        destination.unlink()
    except FileNotFoundError:
        pass
    except PermissionError:
        die(f"Permission denied removing {destination}. Re-run with sudo to uninstall it.")
    print("Removed the local brl-pin installation.")

def usage():
    print(__doc__.strip())
    sys.exit(1)

def list_pins(content: str):
    print("Current pins in [cross-bin]:")
    found = False
    for line in content.splitlines():
        stripped = line.strip()
        if stripped.startswith("pin/bin/"):
            print(f"  {stripped}")
            found = True
    if not found:
        print("  (none)")

def remove_pin(content: str, cmd: str) -> str:
    pattern = re.compile(rf"^\s*pin/bin/{re.escape(cmd)}\s*=")
    new_lines = [line for line in content.splitlines() if not pattern.match(line)]
    return "\n".join(new_lines) + "\n"

def add_pin(content: str, cmd: str, stratum: str, path: str) -> str:
    pin_line = f"pin/bin/{cmd} = {stratum}:{path}"

    # First remove any existing pin for this command
    content = remove_pin(content, cmd)

    lines = content.splitlines()
    final = []
    inserted = False

    for line in lines:
        final.append(line)
        if line.strip() == "[cross-bin]" and not inserted:
            final.append(pin_line)
            inserted = True

    if not inserted:
        # Section didn't exist – create it
        final.append("")
        final.append("[cross-bin]")
        final.append(pin_line)

    return "\n".join(final) + "\n"

def find_pin(content: str, cmd: str):
    pattern = re.compile(rf"^\s*pin/bin/{re.escape(cmd)}\s*=\s*(.+)$")
    found = None
    for line in content.splitlines():
        match = pattern.match(line)
        if match:
            found = match.group(1).strip()
    if found is None or ":" not in found:
        die(f"No valid pin found for '{cmd}'. Pin it first with brl-pin {cmd} <stratum>.")
    stratum, path = found.split(":", 1)
    if not stratum or not path:
        die(f"No valid pin found for '{cmd}'.")
    return stratum, path

def desktop_home():
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user:
        try:
            return pwd.getpwnam(sudo_user)
        except KeyError:
            die(f"Could not find home directory for user '{sudo_user}'.")
    return pwd.getpwuid(os.getuid())

def desktop_application_dirs(home: Path, preferred_stratum: str):
    strata_dir = Path("/bedrock/strata")
    strata = []
    if strata_dir.is_dir():
        strata = [stratum for stratum in strata_dir.iterdir() if stratum.name != "bedrock"]
    preferred = [stratum for stratum in strata if stratum.name == preferred_stratum]
    remaining = [stratum for stratum in strata if stratum.name != preferred_stratum]
    directories = [
        *(stratum / "usr/share/applications" for stratum in preferred),
        home / ".local/share/applications",
        Path("/usr/local/share/applications"),
        Path("/usr/share/applications"),
        *(stratum / "usr/share/applications" for stratum in remaining),
    ]

    unique = []
    seen = set()
    for directory in directories:
        if directory not in seen:
            seen.add(directory)
            unique.append(directory)
    return unique

def desktop_files(directory: Path):
    for current, subdirectories, filenames in os.walk(directory, followlinks=False):
        subdirectories[:] = [name for name in subdirectories if not (Path(current) / name).is_symlink()]
        for filename in filenames:
            if filename.endswith(".desktop"):
                yield Path(current) / filename

def desktop_fields(content: str):
    fields = {}
    in_desktop_entry = False
    for line in content.splitlines():
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            in_desktop_entry = stripped == "[Desktop Entry]"
        elif in_desktop_entry and "=" in line and not stripped.startswith("#"):
            key, value = line.split("=", 1)
            fields[key.strip()] = value.strip()
    return fields

def desktop_exec(line: str):
    key, separator, value = line.partition("=")
    if not separator or key.strip() != "Exec":
        return None
    try:
        arguments = shlex.split(value, posix=True)
    except ValueError:
        return None
    return arguments[0] if arguments else None

def desktop_quote(value: str):
    if re.fullmatch(r"[A-Za-z0-9_./:+-]+", value):
        return value
    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
    escaped = escaped.replace("`", "\\`").replace("$", "\\$").replace("%", "%%")
    return f'"{escaped}"'

def rewrite_desktop_exec(line: str, stratum: str, path: str):
    key, separator, value = line.partition("=")
    if not separator:
        return line
    match = re.match(r'^(\s*)(?:"((?:\\.|[^"])*)"|(\S+))(.*)$', value)
    if not match:
        die(f"Cannot parse desktop Exec line: {line}")
    executable = " ".join(
        desktop_quote(part) for part in ("/bedrock/bin/strat", stratum, path)
    )
    return f"{key}{separator}{match.group(1)}{executable}{match.group(4)}"

def set_desktop_fields(content: str, updates: dict[str, str]):
    lines = content.splitlines()
    in_desktop_entry = False
    found = set()
    insertion_index = None
    for index, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            if in_desktop_entry:
                insertion_index = index
                break
            in_desktop_entry = stripped == "[Desktop Entry]"
            if in_desktop_entry:
                insertion_index = len(lines)
        elif in_desktop_entry and "=" in line and not stripped.startswith("#"):
            key = line.split("=", 1)[0].strip()
            if key in updates:
                lines[index] = f"{key}={updates[key]}"
                found.add(key)

    if not in_desktop_entry:
        lines = ["[Desktop Entry]", *lines]
        insertion_index = 1
    additions = [f"{key}={value}" for key, value in updates.items() if key not in found]
    lines[insertion_index:insertion_index] = additions
    return "\n".join(lines) + "\n"

def sync_desktop_entry(content: str, cmd: str, stratum: str, path: str):
    lines = content.splitlines()
    in_desktop_entry = False
    exec_index = None
    exec_command = None
    fields = desktop_fields(content)
    is_managed = fields.get("X-brl-pin-Command") == cmd
    for index, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            in_desktop_entry = stripped == "[Desktop Entry]"
        elif in_desktop_entry and stripped.startswith("Exec="):
            exec_index = index
            exec_command = desktop_exec(stripped)
            break

    if exec_index is not None and (
        is_managed or (exec_command and Path(exec_command).name == cmd)
    ):
        lines[exec_index] = rewrite_desktop_exec(lines[exec_index], stratum, path)
        return set_desktop_fields(
            "\n".join(lines),
            {"X-brl-pin-Managed": "true", "X-brl-pin-Command": cmd},
        )
    return None

def ensure_desktop_directory(directory: Path, user):
    missing = []
    parent = directory
    while not parent.exists():
        missing.append(parent)
        parent = parent.parent
    directory.mkdir(parents=True, exist_ok=True)
    for created in missing:
        os.chown(created, user.pw_uid, user.pw_gid)

def write_user_desktop_entry(entry: Path, content: str, user):
    ensure_desktop_directory(entry.parent, user)
    entry.write_text(content)
    os.chown(entry, user.pw_uid, user.pw_gid)

def sync_desktop(cmd: str, content: str):
    if not cmd or Path(cmd).name != cmd:
        die("desktop command must be an executable name, not a path")
    stratum, path = find_pin(content, cmd)
    if not Path(path).is_absolute():
        die(f"Pin for '{cmd}' does not contain an absolute executable path.")
    user = desktop_home()
    home = Path(user.pw_dir)
    applications = home / ".local/share/applications"
    matches = {}
    for directory in desktop_application_dirs(home, stratum):
        if not directory.is_dir():
            continue
        for entry in desktop_files(directory):
            try:
                original = entry.read_text()
            except (OSError, UnicodeError):
                continue
            updated = sync_desktop_entry(original, cmd, stratum, path)
            if updated is not None:
                relative = entry.relative_to(directory)
                matches.setdefault(relative, updated)

    if matches:
        for relative, updated in matches.items():
            try:
                write_user_desktop_entry(applications / relative, updated, user)
            except OSError as error:
                die(f"Failed to update desktop entry {applications / relative}: {error}")
        print(f"Updated {len(matches)} desktop entr{'y' if len(matches) == 1 else 'ies'} for '{cmd}'.")
        return

    try:
        ensure_desktop_directory(applications, user)
        entry = applications / f"{cmd}-brl-pin.desktop"
        fields = {
            "Name": cmd.replace("-", " ").replace("_", " ").title(),
            "Exec": " ".join(
                desktop_quote(part) for part in ("/bedrock/bin/strat", stratum, path)
            ),
            "Icon": "application-x-executable",
            "Type": "Application",
            "Terminal": "false",
            "Categories": "Utility;",
            "X-brl-pin-Managed": "true",
            "X-brl-pin-Command": cmd,
        }
        entry.write_text(
            "[Desktop Entry]\n"
            + "".join(f"{key}={value}\n" for key, value in fields.items())
        )
        os.chown(entry, user.pw_uid, user.pw_gid)
    except OSError as error:
        die(f"Failed to create desktop entry for '{cmd}': {error}")
    print(f"Created desktop entry {entry} for '{cmd}'.")

def remove_desktop(cmd: str):
    if not cmd or Path(cmd).name != cmd:
        die("desktop command must be an executable name, not a path")
    user = desktop_home()
    applications = Path(user.pw_dir) / ".local/share/applications"
    removed = 0
    if applications.is_dir():
        for entry in desktop_files(applications):
            try:
                content = entry.read_text()
            except (OSError, UnicodeError):
                continue
            fields = desktop_fields(content)
            tokens = []
            try:
                tokens = shlex.split(fields.get("Exec", ""), posix=True)
            except ValueError:
                pass
            managed = fields.get("X-brl-pin-Command") == cmd
            legacy = (
                len(tokens) >= 3
                and Path(tokens[0]).name == "strat"
                and Path(tokens[2]).name == cmd
                and entry.stem in {cmd, f"{cmd}-brl-pin"}
            )
            if managed or legacy:
                try:
                    entry.unlink()
                except OSError as error:
                    die(f"Failed to remove desktop entry {entry}: {error}")
                removed += 1
    if removed:
        print(f"Removed {removed} managed desktop entr{'y' if removed == 1 else 'ies'} for '{cmd}'.")
    else:
        print(f"No managed desktop entries found for '{cmd}'.")

def main():
    if len(sys.argv) < 2:
        usage()

    args = sys.argv[1:]

    if args[0] in {"--install", "--update", "--uninstall"}:
        if len(args) != 1:
            usage()
        {
            "--install": install_tool,
            "--update": update_tool,
            "--uninstall": uninstall_tool,
        }[args[0]]()
        return

    # --list does not need root
    if args[0] == "--list":
        content = read_conf()
        list_pins(content)
        return

    # Everything else needs root
    require_root()
    content = read_conf()

    if args[0] == "--rm":
        if len(args) != 2:
            usage()
        cmd = args[1]
        new_content = remove_pin(content, cmd)
        write_conf(new_content)
        print(f"Removed pin for '{cmd}'")
        apply_config()
        return

    if args[0] == "--desktop":
        if len(args) != 2:
            usage()
        sync_desktop(args[1], content)
        return

    if args[0] == "--desktop-rm":
        if len(args) != 2:
            usage()
        remove_desktop(args[1])
        return

    if len(args) != 2:
        usage()

    cmd, stratum = args
    if not cmd or not stratum:
        die("command and stratum must be non-empty")

    path = resolve_command(cmd, stratum)
    new_content = add_pin(content, cmd, stratum, path)
    write_conf(new_content)
    print(f"Pinned {cmd} → {stratum}:{path}")
    apply_config()
    print("Applied successfully.")

if __name__ == "__main__":
    main()
